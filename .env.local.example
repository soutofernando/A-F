# Copie para .env.local e preencha
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (serviço admin, usado apenas em API routes)
SUPABASE_SERVICE_ROLE_KEY=

# Emails autorizados no admin (separados por vírgula)
ADMIN_EMAILS=seu@email.com

# URL pública do site (metadados Open Graph / favicon)
NEXT_PUBLIC_SITE_URL=https://aliciaefernando.com

# Supabase Dashboard → Auth → URL Configuration:
#   Site URL (dev): http://localhost:3000
#   Redirect URLs: http://localhost:3000/auth/callback**
#   Redirect URLs (prod): https://aliciaefernando.com/auth/callback**

# Pagamento (preencher quando integrar)
MERCADOPAGO_ACCESS_TOKEN=
PIX_KEY=
