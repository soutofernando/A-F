# Copie para .env.local e preencha
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (serviço admin, usado apenas em API routes)
SUPABASE_SERVICE_ROLE_KEY=

# Únicos e-mails que podem logar no /admin (separados por vírgula; minúsculas).
# Defina o MESMO valor na Vercel (Settings → Environment Variables).
# O e-mail também precisa existir em public.admins no Supabase (migration seed).
ADMIN_EMAILS=seu@email.com

# URL pública do site (metadados Open Graph / favicon)
NEXT_PUBLIC_SITE_URL=https://aliciaefernando.com

# Supabase Dashboard → Authentication → URL Configuration:
#   Site URL: https://alicia-fernando.vercel.app
#   Redirect URLs:
#     http://localhost:3000/auth/callback**
#     http://localhost:3000/
#     https://alicia-fernando.vercel.app/**
#     http://localhost:3000/**

# Mercado Pago → Suas integrações → Credenciais de produção.
# O checkout avisa o site em /api/mercadopago/webhook.
MERCADOPAGO_ACCESS_TOKEN=
# Opcional. Segredo da assinatura, se você criar um webhook no painel.
MERCADOPAGO_WEBHOOK_SECRET=
# Parcelamento no MP: buyer = juros do convidado (padrão). seller = parcelado loja sem juros (você absorve).
MERCADOPAGO_INSTALLMENT_FINANCING=buyer
# Máximo de parcelas no checkout (1–12). No modo seller, a taxa embutida usa este teto.
MERCADOPAGO_CARD_MAX_INSTALLMENTS=6
# Taxa da operação no crédito à vista (0.05 = 5%, como R$ 10 → R$ 9,50 líquidos).
MERCADOPAGO_CARD_FEE_RATE=0.05
# Só no modo seller: taxa total estimada se alguém usar o máximo de parcelas (consulte o simulador do MP).
MERCADOPAGO_CARD_FEE_RATE_AT_MAX_INSTALLMENTS=0.16
PIX_KEY=
